# Server-side secrets for the delete-account edge function. Copy to .env
# (git-ignored) and fill in only what you use. Every value is optional: when
# one is missing, that clean-up step is skipped and the account is still
# deleted from the database.
# Push to Supabase ONLY with: .\supabase\deploy-functions.ps1
# It uploads just the names listed below. Do not run
# `npx supabase secrets set --env-file supabase/functions/.env` directly: that
# pushes every line in the file, including any retired key (such as an old
# OPENAI_API_KEY) still sitting in your local copy.
#
# Note: SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are
# injected automatically by the Supabase platform - never put them here and
# never ship the service role key anywhere client-side.

# RevenueCat SECRET API key (Project settings -> API keys -> Secret keys, v1).
# Used only to delete the deleted user's RevenueCat customer record.
REVENUECAT_SECRET_API_KEY=

# PostHog, to delete the deleted user's person and events.
# Personal API key with the person:write scope (Account settings -> Personal
# API keys), the numeric project ID, and the APP host (https://us.posthog.com
# or https://eu.posthog.com), not the i. ingestion host the app sends to.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.posthog.com
