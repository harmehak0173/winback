# Copy to .env and fill in. All features degrade gracefully when unset:
# the app runs fully offline, and in development purchases run in simulated
# mode. Every EXPO_PUBLIC_ value is compiled into the app and readable by
# anyone, so never put a server secret here (Supabase service-role keys,
# RevenueCat secret keys and PostHog personal keys belong in
# supabase/functions/.env or EAS secrets, never in this file).
#
# .env is for local development only. It is gitignored, so EAS Build never
# sees it: set build values with `eas env:create --environment <name>` (the
# build profiles in eas.json pick them up through "environment").
# `npm run check:build-env -- --profile production --platform ios` shows what
# a production build would refuse.

# Build flavour: development | preview | production. "production" turns off
# simulated purchases and makes missing store keys a hard error. eas.json sets
# this per profile; leave it unset locally.
EXPO_PUBLIC_APP_ENV=

# Supabase (enable "Allow anonymous sign-ins" in Authentication -> Providers,
# then run supabase/setup-all.sql in the SQL editor). Use the publishable (anon)
# key, never a secret key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public SDK keys (Project -> API keys): appl_... for iOS and
# goog_... for Android. test_... keys are the RevenueCat Test Store and are
# refused by production builds. Requires a dev build - purchases are
# simulated in Expo Go.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# PostHog funnel analytics (optional). Only non-health funnel events go
# there, and nothing is sent when the user turns off "Share usage data".
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# TheSportsDB key for game-day reminders. Unset, a development or preview
# build uses the free test key "123" (development use only, by TheSportsDB's
# terms); a production build needs the paid key and refuses to build without.
EXPO_PUBLIC_THESPORTSDB_KEY=

# Hosted pages generated into site/ by `npm run sync:legal` (both stores
# require a privacy policy URL; Google Play also requires an account-deletion
# page). Host site/ flat, as the files are named (privacy.html, terms.html, ...).
# When EXPO_PUBLIC_HEALTH_DATA_URL is unset and the privacy URL ends in .html,
# the health-data page is assumed to sit next to it (health-data.html).
# The app shows its built-in copy when these are unset.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_SUPPORT_URL=
EXPO_PUBLIC_DELETE_URL=
EXPO_PUBLIC_HEALTH_DATA_URL=
