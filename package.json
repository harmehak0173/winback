{
  "name": "winback",
  "main": "index.js",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "sync:legal": "node scripts/sync-legal.mjs",
    "check:build-env": "node scripts/check-build-env.mjs",
    "precheck:copy": "node scripts/sync-legal.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "eas-build-pre-install": "node scripts/check-build-env.mjs",
    "check:update-env:preview": "eas env:exec preview \"node scripts/check-build-env.mjs --update preview\"",
    "check:update-env:production": "eas env:exec production \"node scripts/check-build-env.mjs --update production\"",
    "update:preview": "npm run check:update-env:preview && eas update --channel preview --environment preview",
    "update:production": "npm run check:update-env:production && eas update --channel production --environment production",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "e2e:build": "node scripts/sync-legal.mjs && node scripts/e2e-build.mjs",
    "test:e2e": "npm run e2e:build && playwright test",
    "test:sql": "node --test supabase/tests/sql.test.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/hanken-grotesk": "^0.4.3",
    "@expo/ui": "~57.0.20",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.110.2",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.3",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.0",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-android-widget": "^0.21.0",
    "react-native-purchases": "^10.4.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.12",
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.64.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts?(x)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/e2e/"
    ]
  }
}
