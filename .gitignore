# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# env: every variant (.env.production, .env.staging...), except the examples
.env
.env*
!.env.example

# supabase CLI scratch
supabase/.temp/

# transient eas build:view output
*.json.tmp
# eas build:view scratch output
b[0-9]*.json
bs.json
pv.json
pw.json

# build-log scratch
buildlog.txt
bl.txt
sentrylog.txt

# Local build-status dumps from the EAS monitor, never part of the app
ba.json
bi.json

# Store credentials (Google Play service account for eas submit). Never commit.
secrets/

# Replica skill research (third-party reviews and screenshots; never shipped)
replica/

# end-to-end test build and reports
dist-e2e/
test-results/
playwright-report/

# Generated by npm run sync:legal from src/state/legal.ts: each operator publishes its own.
/site/*.html
/docs/privacy-policy.md
/docs/terms.md
